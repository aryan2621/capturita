{
  "name": "capturita-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:worker": "wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply capturita-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply capturita-db --remote",
    "deploy": "pnpm build && wrangler deploy",
    "keygen": "node scripts/keygen.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "hono": "^4.13.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
