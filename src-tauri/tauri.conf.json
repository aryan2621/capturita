{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capturita",
  "version": "0.1.3",
  "identifier": "com.capturita.app",
  "build": {
    "beforeDevCommand": "npm run build:recorder && ./scripts/build-llama-server.sh && ./scripts/build-studio-renderer.sh --dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:recorder && ./scripts/build-llama-server.sh && ./scripts/build-studio-renderer.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Capturita",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/Capturita/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/capturita-recorder",
      "binaries/llama-server",
      "binaries/studio-node"
    ],
    "resources": {
      "studio-runtime/": "studio-renderer/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
